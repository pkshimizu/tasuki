{
  "name": "tasuki-agent",
  "version": "0.1.0",
  "description": "要件から仕様・タスク分解・実装・レビューまでを、役割ごとのエージェントで進めるソフトウェア開発 AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkshimizu/tasuki.git"
  },
  "homepage": "https://github.com/pkshimizu/tasuki#readme",
  "private": true,
  "type": "module",
  "bin": {
    "tasuki": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "start": "node dist/cli.js",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:web": "vite --config web/vite.config.ts"
  },
  "engines": {
    "node": ">=22.13 <23"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.330",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
